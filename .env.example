# DexKeeper_Bot Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Telegram Bot Token from @BotFather
# Get this by messaging @BotFather on Telegram and using /newbot
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# OPTIONAL: Your Telegram User ID (for admin privileges)
# Find yours by messaging @userinfobot on Telegram
# If not set, defaults to 0 (database-backed admins can still be promoted later)
ADMIN_ID=0

# OPTIONAL: Database file path
# Defaults to the per-user DexKeeper data directory:
# - Windows: %APPDATA%/DexKeeper/dexkeeper.db
# - macOS: ~/Library/Application Support/DexKeeper/dexkeeper.db
# - Linux: ~/.local/share/DexKeeper/dexkeeper.db
# - Docker: /app/data/dexkeeper.db
# DB_PATH=/absolute/path/to/dexkeeper.db

# OPTIONAL: Override data directory location
# On Windows/macOS/Linux installs, defaults to a per-user app data folder.
# DEXKEEPER_DATA_DIR=/path/to/data

# OPTIONAL: Disable tray icon (default enabled)
# DEXKEEPER_TRAY=0

# OPTIONAL: Disable update check prompt (default enabled)
# DEXKEEPER_AUTO_UPDATE=0

# OPTIONAL: Silent mode (disables popups, logs only)
# DEXKEEPER_SILENT=1

# OPTIONAL: Custom log file path
# DEXKEEPER_LOG_PATH=/absolute/path/to/dexkeeper.log

# OPTIONAL: Disable file logging entirely (stdout/stderr only)
# DEXKEEPER_DISABLE_FILE_LOG=1
