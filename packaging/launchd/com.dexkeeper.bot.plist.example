<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dexkeeper.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/DexKeeper_Bot/.venv/bin/python</string>
    <string>/path/to/DexKeeper_Bot/Sources/DexKeeper_Bot/dexkeeper_bot.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/DexKeeper_Bot</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dexkeeper.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dexkeeper.err.log</string>
</dict>
</plist>
